<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FatouraDZ.ViewModels"
             x:Class="FatouraDZ.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Classes="section-header">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Content="← Retour" 
                        Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="10,8"
                        Margin="0,0,20,0"/>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Paramètres" Classes="h2"/>
                    <TextBlock Text="Configuration de l'application" Classes="caption"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content with Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="30,20">
            <!-- Tab: Base de données -->
            <TabItem Header="💾 Base de données">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="600" Margin="0,0,0,80">
                        <TextBlock Text="Gestion de la base de données" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Exportez et importez vos données pour les sauvegarder ou les transférer vers un autre appareil." 
                                   Foreground="#64748B" TextWrapping="Wrap"/>

                        <!-- Export Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📤" FontSize="24"/>
                                    <StackPanel>
                                        <TextBlock Text="Exporter la base de données" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Créer une sauvegarde de toutes vos données" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Exporter maintenant" 
                                        Command="{Binding ExporterBaseDeDonneesCommand}"
                                        Padding="15,10"
                                        Background="#2563EB"
                                        Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Import Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📥" FontSize="24"/>
                                    <StackPanel>
                                        <TextBlock Text="Importer une sauvegarde" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Restaurer vos données depuis une sauvegarde" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Importer une sauvegarde" 
                                        Command="{Binding ImporterBaseDeDonneesCommand}"
                                        Padding="15,10"
                                        Background="#10B981"
                                        Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Open Folder -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📁" FontSize="24"/>
                                    <StackPanel>
                                        <TextBlock Text="Dossier des sauvegardes" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Ouvrir le dossier contenant les fichiers de sauvegarde" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Ouvrir le dossier" 
                                        Command="{Binding OuvrirDossierExportCommand}"
                                        Padding="15,10"
                                        Background="#6366F1"
                                        Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10" Background="#E2E8F0"/>

                        <!-- Database Location -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📍" FontSize="24"/>
                                    <StackPanel>
                                        <TextBlock Text="Emplacement de la base de données" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Changer l'emplacement où vos données sont stockées" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Emplacement actuel :" FontWeight="Medium" FontSize="12"/>
                                    <TextBox Text="{Binding CheminBaseDeDonnees}" IsReadOnly="True" 
                                             Background="#F8FAFC" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Changer l'emplacement" 
                                            Command="{Binding ChangerEmplacementBaseDeDonneesCommand}"
                                            Padding="15,10"
                                            Background="#F59E0B"
                                            Foreground="White"/>
                                    <Button Content="Réinitialiser" 
                                            Command="{Binding ReinitialiserEmplacementCommand}"
                                            Padding="15,10"
                                            Background="#94A3B8"
                                            Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Success Message -->
                        <Border Background="#D1FAE5" CornerRadius="8" Padding="15"
                                IsVisible="{Binding MessageSucces, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MessageSucces}" Foreground="#065F46" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Error Message -->
                        <Border Background="#FEE2E2" CornerRadius="8" Padding="15"
                                IsVisible="{Binding MessageErreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MessageErreur}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Paramètres fiscaux -->
            <TabItem Header="📊 Fiscalité">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="600" Margin="0,0,0,80">
                        <TextBlock Text="Paramètres fiscaux" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Configurez les taux de TVA, timbre fiscal et autres paramètres légaux. Ces valeurs peuvent changer selon la législation en vigueur." 
                                   Foreground="#64748B" TextWrapping="Wrap"/>

                        <!-- TVA Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="💰" FontSize="24"/>
                                    <TextBlock Text="Taux de TVA" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="TVA Standard (%)" FontWeight="Medium" FontSize="12"/>
                                        <NumericUpDown Value="{Binding TauxTVAStandard}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.##"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="TVA Réduit (%)" FontWeight="Medium" FontSize="12"/>
                                        <NumericUpDown Value="{Binding TauxTVAReduit}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.##"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Timbre Fiscal Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="🏛️" FontSize="24"/>
                                    <TextBlock Text="Timbre Fiscal" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Barème progressif appliqué au montant TTC des factures réglées en espèces (Loi de Finances 2025, art. 100 du code du timbre)." 
                                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="*,20,*">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Seuil d'exonération (DZD)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreSeuilExoneration}" Minimum="0" Maximum="100000" Increment="50" FormatString="N0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Minimum de perception (DZD)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreMinimum}" Minimum="0" Maximum="10000" Increment="1" FormatString="N0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,20,*">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Tranche 1 — jusqu'à (DZD)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreSeuil1}" Minimum="0" Maximum="1000000" Increment="1000" FormatString="N0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Taux tranche 1 (%)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreTaux1}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,20,*">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Tranche 2 — jusqu'à (DZD)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreSeuil2}" Minimum="0" Maximum="10000000" Increment="1000" FormatString="N0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Taux tranche 2 (%)" FontWeight="Medium" FontSize="12"/>
                                            <NumericUpDown Value="{Binding TimbreTaux2}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="5" MaxWidth="200" HorizontalAlignment="Left">
                                        <TextBlock Text="Taux au-delà de la tranche 2 (%)" FontWeight="Medium" FontSize="12"/>
                                        <NumericUpDown Value="{Binding TimbreTaux3}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4" HorizontalAlignment="Left">
                                        <CheckBox IsChecked="{Binding TimbreArrondiTrancheCent}"
                                                  Content="Arrondir l'assiette par tranche de 100 DA"
                                                  FontWeight="Medium" FontSize="12"/>
                                        <TextBlock Text="Libellé littéral du barème : « par tranche de 100 DA ou fraction de tranche ». Si activé, l'assiette est portée au palier de 100 DA supérieur avant application du taux (ex. 49 950 DA → 50 000 DA). Désactivé par défaut."
                                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" MaxWidth="480"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Retenue à la Source Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📋" FontSize="24"/>
                                    <TextBlock Text="Retenue à la Source" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Spacing="5" MaxWidth="200" HorizontalAlignment="Left">
                                    <TextBlock Text="Taux par défaut (%)" FontWeight="Medium" FontSize="12"/>
                                    <NumericUpDown Value="{Binding TauxRetenueSourceDefaut}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.##"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Invoice Settings Section -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📄" FontSize="24"/>
                                    <TextBlock Text="Paramètres de facturation" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="*,20,*">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Format numéro facture" FontWeight="Medium" FontSize="12"/>
                                        <TextBox Text="{Binding FormatNumeroFacture}"/>
                                        <TextBlock Text="Variables: {ANNEE}, {NUM}" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="Délai paiement (jours)" FontWeight="Medium" FontSize="12"/>
                                        <NumericUpDown Value="{Binding DelaiPaiementDefaut}" Minimum="0" Maximum="365" Increment="1" FormatString="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Enregistrer les paramètres" 
                                    Command="{Binding EnregistrerParametresFiscauxCommand}"
                                    Padding="20,12"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>
                            <Button Content="Réinitialiser" 
                                    Command="{Binding ReinitialiserParametresFiscauxCommand}"
                                    Padding="20,12"
                                    Background="#94A3B8"
                                    Foreground="White"/>
                        </StackPanel>

                        <!-- Success Message -->
                        <Border Background="#D1FAE5" CornerRadius="8" Padding="15"
                                IsVisible="{Binding MessageSucces, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MessageSucces}" Foreground="#065F46" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Error Message -->
                        <Border Background="#FEE2E2" CornerRadius="8" Padding="15"
                                IsVisible="{Binding MessageErreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MessageErreur}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: À propos -->
            <TabItem Header="À propos">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Center" Margin="0,0,0,80">
                        <!-- App Logo/Title -->
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Border Background="#2563EB" CornerRadius="16" Padding="20" HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="48"/>
                            </Border>
                            <TextBlock Text="FatouraDZ" FontSize="28" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" 
                                       FontSize="14" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Description -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Features -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Fonctionnalités" FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="✓ Gestion multi-entreprises" Foreground="#64748B"/>
                                    <TextBlock Text="✓ Factures, avoirs et proformas" Foreground="#64748B"/>
                                    <TextBlock Text="✓ TVA" Foreground="#64748B"/>
                                    <TextBlock Text="✓ Timbre fiscal automatique" Foreground="#64748B"/>
                                    <TextBlock Text="✓ Retenue à la source" Foreground="#64748B"/>
                                    <TextBlock Text="✓ Export PDF" Foreground="#64748B"/>
                                    <TextBlock Text="✓ Sauvegarde et restauration" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Developer Info -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Développeur" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Developpeur}" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Contact}" Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>

                        <!-- Mises à jour -->
                        <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Mises à jour" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="FatouraDZ vérifie au plus une fois par jour si une nouvelle version est publiée sur GitHub. Aucune donnée personnelle n'est transmise, et l'installation reste un téléchargement explicite."
                                           Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                <CheckBox Content="Vérifier automatiquement au démarrage"
                                          IsChecked="{Binding VerifierMisesAJour}"
                                          FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Vérifier maintenant"
                                            Command="{Binding VerifierMisesAJourCommand}"
                                            Padding="15,8"/>
                                    <TextBlock Text="{Binding MessageMiseAJour}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Copyright -->
                        <TextBlock Text="© 2026 FatouraDZ. Tous droits réservés." 
                                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
