<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="560"
        x:Class="FatouraDZ.Views.CrashWindow"
        Title="FatouraDZ — erreur"
        Width="640" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="⚠️" FontSize="28" VerticalAlignment="Top"/>
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitreText" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock x:Name="OrigineText" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFEBEE" BorderBrush="#EF4444" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,15,0,0">
            <TextBlock x:Name="ResumeText" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,15,0,0">
            <TextBlock Text="Un rapport détaillé a été enregistré sur votre disque :"
                       FontSize="12" FontWeight="Medium" Foreground="#1E293B"/>
            <TextBlock x:Name="CheminText" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <Expander Grid.Row="3" Header="Détails techniques" Margin="0,10,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer Height="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="DetailsBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                         FontSize="11"
                         MinHeight="220"/>
            </ScrollViewer>
        </Expander>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,15,0,0">
            <Button x:Name="CopierButton" Content="Copier les détails"
                    Click="OnCopierClick" Padding="15,8"/>
            <Button x:Name="OuvrirDossierButton" Content="Ouvrir le dossier"
                    Click="OnOuvrirDossierClick" Padding="15,8"/>
            <Button Content="Signaler le problème"
                    Click="OnSignalerClick" Padding="15,8"/>
            <Button Content="Fermer" Classes="primary"
                    Click="OnFermerClick" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
