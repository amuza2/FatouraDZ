<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!--
      Identité de l'application : reprise par l'écran « À propos », l'icône du
      .exe et les métadonnées de packaging.

      Une release écrase Version avec -p:Version=<tag> (scripts/build-release.sh),
      donc l'assembly, l'écran « À propos » et le nom de l'artefact annoncent
      toujours la même version. La valeur ci-dessous n'est utilisée que pour un
      build local.
    -->
    <Version>0.1.0</Version>
    <Product>FatouraDZ</Product>
    <AssemblyTitle>FatouraDZ</AssemblyTitle>
    <Description>Application de facturation pour les entreprises algériennes</Description>
    <Company>amuza2</Company>
    <Authors>amuza2</Authors>
    <Copyright>© 2026 amuza2</Copyright>
    <RepositoryUrl>https://github.com/amuza2/FatouraDZ</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Icône embarquée dans l'exécutable (Windows). Les sources sont dans
         packaging/icons/ ; scripts/gen-icons.sh régénère ce fichier. -->
    <ApplicationIcon>Assets\fatouradz.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Microsoft.EntityFrameworkCore.Design n'est utile que pour générer les migrations
    (`dotnet ef`). Le paquet dépose son hôte de compilation MSBuild dans la sortie
    publiée (BuildHost-netcore/, BuildHost-net472/) : l'application ne l'utilise
    jamais, et le laisser dans les artefacts livre à l'utilisateur des dossiers
    incompréhensibles à côté de l'exécutable.

    La suppression ne concerne que la publication : la sortie de compilation reste
    intacte, donc `dotnet ef migrations add` continue de fonctionner.
  -->
  <Target Name="RetirerOutillageDesignDeLaPublication" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.9">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Material.Avalonia" Version="3.13.4" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Nécessaire uniquement pour générer les migrations (dotnet ef) ; non déployé. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />

    <!-- Security overrides: pin patched versions of vulnerable transitive dependencies -->
    <!-- GHSA-2m69-gcr7-jv3q (CVE-2025-6965): SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 -> via Microsoft.EntityFrameworkCore.Sqlite -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959): Tmds.DBus.Protocol < 0.21.3 -> via Avalonia.FreeDesktop -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- Vulnérabilités multiples (NU1903): System.Security.Cryptography.Xml 9.0.0 -> via Microsoft.EntityFrameworkCore.Design (outillage uniquement) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>
</Project>
